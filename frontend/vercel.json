{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "devCommand": "npm run dev",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/dispatch?job=all",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/scrape-gmail",
      "schedule": "15 2 * * *"
    }
  ]
}
