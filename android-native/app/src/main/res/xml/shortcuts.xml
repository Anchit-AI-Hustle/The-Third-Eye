<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon; Google Assistant also opens these by name ("Hey Google, Talk on The Third Eye"). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="talk"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_talk"
        android:shortcutLongLabel="@string/shortcut_talk_long">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.thethirdeye.app"
            android:targetClass="com.thethirdeye.app.MainActivity" android:data="thethirdeye://call" />
    </shortcut>
    <shortcut
        android:shortcutId="ask"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_ask"
        android:shortcutLongLabel="@string/shortcut_ask_long">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.thethirdeye.app"
            android:targetClass="com.thethirdeye.app.MainActivity" android:data="thethirdeye://assistant" />
    </shortcut>
    <shortcut
        android:shortcutId="briefing"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_briefing"
        android:shortcutLongLabel="@string/shortcut_briefing_long">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.thethirdeye.app"
            android:targetClass="com.thethirdeye.app.MainActivity" android:data="thethirdeye://assistant?ask=Give%20me%20my%20morning%20briefing" />
    </shortcut>
</shortcuts>
