# ══════════════════════════════════════════════════════════════
#  The Third Eye — Environment Variables Reference
#  Copy to .env and fill in your values. Never commit .env.
# ══════════════════════════════════════════════════════════════

# ─── Core ──────────────────────────────────────────────────────
# Environment: development | production | test
ENVIRONMENT=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Secret key for JWT signing (generate: openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-this-in-production

# Shared secret for the external cron trigger (POST /internal/run-
# consolidation, called by .github/workflows/backend-consolidation-cron.yml
# as GitHub repo secret BACKEND_CRON_SECRET). Leave unset to disable the
# endpoint entirely — it 404s rather than existing. Generate: openssl rand
# -hex 32. Only needed on scale-to-zero compute, where the in-process
# APScheduler job can't be relied on to fire (see PROJECT_STATUS.md).
INTERNAL_CRON_SECRET=

# ─── Database ──────────────────────────────────────────────────
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
# Strong password required — min 20 chars in production
POSTGRES_PASSWORD=change-me-strong-password

# Full async connection URL (auto-constructed from above in docker)
# Override manually if using an external database — e.g. a free-tier Supabase
# Postgres connection string, if reusing it instead of a paid second database
# (see PROJECT_STATUS.md's backend deploy plan). Pair with DB_SCHEMA below
# when doing that.
DATABASE_URL=postgresql+asyncpg://jarvis:change-me-strong-password@localhost:5432/jarvis

# Sync URL used by Alembic migrations only
DATABASE_URL_SYNC=postgresql://jarvis:change-me-strong-password@localhost:5432/jarvis

# Postgres schema this service's tables live in. Leave as "public" for a
# dedicated database (e.g. local docker-compose). Set to something else
# (e.g. "backend_app") only when DATABASE_URL points at a Postgres instance
# shared with something else — keeps this service's tables out of that
# instance's own "public" schema. Letters/digits/underscore only.
DB_SCHEMA=public

# ─── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@localhost:6379/0

# ─── Encryption ────────────────────────────────────────────────
# AES-256 key for financial data at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FINANCIAL_ENCRYPTION_KEY=your-fernet-key-here

# ─── Authentication (NextAuth.js) ──────────────────────────────
# NextAuth secret (generate: openssl rand -hex 32)
NEXTAUTH_SECRET=your-nextauth-secret-change-this
# Production: full URL including https
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — get from console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth — get from portal.azure.com (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── AI Providers ──────────────────────────────────────────────
# Google AI (Gemini) — get from aistudio.google.com [REQUIRED - default router]
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Gemini model for the Google-Search-grounded route. Override to move to a
# newer model (e.g. gemini-3.5-flash) without a code change.
GOOGLE_GROUNDED_MODEL=gemini-2.5-flash

# When true (default) the research agent answers via Gemini's built-in
# google_search tool if SERPER_API_KEY is unset — no extra key required.
# Set false to keep the old "search unavailable" response instead.
ENABLE_GOOGLE_GROUNDING=true

# OpenAI — get from platform.openai.com [optional - for fallback/code tasks]
OPENAI_API_KEY=

# Anthropic — get from console.anthropic.com [optional - for fallback]
ANTHROPIC_API_KEY=

# Ollama base URL — local LLM for privacy mode (docker service or external)
OLLAMA_BASE_URL=http://ollama:11434

# Serper API — web search for Research Agent (Phase 2)
# Get from https://serper.dev — free tier available
SERPER_API_KEY=

# ─── Frontend ──────────────────────────────────────────────────
# Public API URL (accessible from browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal backend URL (server-to-server, not exposed).
#
# LEAVE THIS UNSET wherever the FastAPI backend is not deployed — a hosted
# frontend on Vercel, for instance. Unset means "no backend": sign-in then skips
# the session-token exchange instead of firing a request that can only fail. The
# value below is the docker-compose service name and resolves only inside that
# network, so it is right for docker and wrong everywhere else.
#
# When you do point this at a real backend, that backend also needs
# GOOGLE_CLIENT_ID set to the same value the frontend uses — it verifies the
# Google ID token's audience against it, and rejects every token without it.
BACKEND_URL=http://backend:8000

# ─── n8n Workflow Engine ───────────────────────────────────────
# n8n uses the main postgres instance with its own database
N8N_DB=n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-n8n-password
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=your-n8n-encryption-key
N8N_WEBHOOK_URL=http://localhost:5678

# ─── Feature Flags ─────────────────────────────────────────────
# Enable/disable optional features
ENABLE_VOICE=false
ENABLE_LOCAL_AI=false
ENABLE_FINANCIAL_MODULE=false

# ─── Rate Limiting ─────────────────────────────────────────────
# Requests per minute per user for AI endpoints
AI_RATE_LIMIT_RPM=60

# Default monthly token budget per user (0 = unlimited)
DEFAULT_MONTHLY_TOKEN_BUDGET=0

# ─── Email (SMTP) — for email auth and notifications ───────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=The Third Eye <no-reply@yourdomain.com>

# ─── Job Agent ─────────────────────────────────────────────────
# Master switch for the /job-agent module. Set to "false" to hide it.
JOB_AGENT_ENABLED=true
# Application automation (browser assistant / form fill). Off by default.
JOB_AGENT_AUTOMATION_ENABLED=false
# Per-source search timeout (ms) and max resume-upload size (MB).
JOB_AGENT_SOURCE_TIMEOUT_MS=8000
JOB_AGENT_MAX_UPLOAD_MB=8
# Optional inline source: Adzuna (both required to enable it).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
# Job Agent AI uses the shared llmCascade providers already configured above —
# no separate key is required. These are reserved for future pinning:
# JOB_AGENT_AI_PROVIDER=
# JOB_AGENT_AI_MODEL=
# Reserved for the staged browser-extension session signing:
# JOB_AGENT_EXTENSION_SIGNING_SECRET=

# ═══════════════════════════════════════════════════════════════
# VERCEL / NEXT.JS FRONTEND
# ═══════════════════════════════════════════════════════════════
# Most of what is above this line targets the docker-compose stack
# (FastAPI + Postgres + Redis). The deployed product is the Next.js
# app in frontend/, running on Vercel against Supabase — these are
# the variables that deployment actually reads.
#
# Four exceptions live above and are ALSO required here, or sign-in
# breaks in production:
#
#   NEXTAUTH_SECRET       (line ~40)  session signing
#   NEXTAUTH_URL          (line ~42)  set to the deployed origin,
#                                     not localhost
#   GOOGLE_CLIENT_ID      (line ~45)  Google OAuth provider
#   GOOGLE_CLIENT_SECRET  (line ~46)
#
# Set those in Vercel alongside everything below.

# ─── Supabase (required) ───────────────────────────────────────
# Anon key is public (RLS-protected); the service-role key bypasses
# RLS entirely — server-side only, never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Kolab Studio (optional — /kolab/studio, embedded from the Kolab repo) ─────
# Kolab Studio is a self-contained creator/brand feature with its OWN Supabase
# project (org/creator/deal schema, entirely separate from the app's own tables
# above — see Kolab's docs/DATA-MODEL.md and docs/SUPABASE-SETUP.md). Leave unset
# to keep the feature dormant; /kolab/studio/* pages fail closed with a clear
# "not configured" error rather than silently pointing at the wrong project.
NEXT_PUBLIC_KOLAB_SUPABASE_URL=
NEXT_PUBLIC_KOLAB_SUPABASE_ANON_KEY=
KOLAB_SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_KOLAB_APP_URL=https://yourdomain.com
KOLAB_DEV_MODE=false
# Comma/space/newline-separated list of complimentary-access phone numbers
# (Kolab CLAUDE.md guardrail #7) — server-side only, never commit real numbers.
KOLAB_PRIVILEGED_NUMBERS=

# ─── Site identity (required) ──────────────────────────────────
# Canonical origin, used for metadata, OG tags, sitemap and OAuth.
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ─── Secrets at rest (required) ────────────────────────────────
# Encrypts stored Google refresh tokens. Rotating it invalidates
# every stored connection. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ─── Vercel Cron (required in production) ──────────────────────
# Shared bearer secret for /api/cron/*. If unset, cron endpoints
# are open in dev and refuse to run in production.
CRON_SECRET=

# ─── Web Push (optional — reminders/digests) ───────────────────
# Generate a keypair: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# ─── Stripe billing (required if ENFORCE_PREMIUM=1) ────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Paywall master switch. Unset/0 = every feature unlocked for all
# users and premium capabilities are badged only, not gated.
ENFORCE_PREMIUM=0
# QA bypass code for previewing paid features without paying.
# NEXT_PUBLIC_* is inlined into the client bundle — anyone can read
# it in devtools. Leave EMPTY in production.
NEXT_PUBLIC_TEST_UNLOCK_CODE=

# ─── AI providers (at least one required) ──────────────────────
# The llmCascade tries these in order and falls through on failure.
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
# Extra OpenAI keys rotated when the primary is rate-limited.
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
# Local Ollama fallback. Checked as OLLAMA_ENABLED === "1", so this is
# the one flag here that is not a true/false boolean — set it to 1 to
# enable. "true" reads as disabled.
OLLAMA_ENABLED=0
OLLAMA_BASE=http://localhost:11434

# ─── Media generation (optional) ───────────────────────────────
REPLICATE_API_TOKEN=
REPLICATE_API_KEY=
HF_API_TOKEN=
HUGGINGFACE_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
HF_MUSIC_MODEL=
MUSIC_SONG_MODEL=
MUSIC_INSTRUMENTAL_MODEL=
MUSIC_INSTRUMENTAL_VERSION=

# ─── Social automation (optional) ──────────────────────────────
AUTOMATION_MODEL=
AUTOMATION_WEBHOOK_URL=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
X_ACCESS_TOKEN=

# ─── Search-console / domain verification (optional) ───────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=
